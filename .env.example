# Public URL of this Next.js app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random 32+ character string: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Same MongoDB database the Express API uses
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=studiospace

# Google OAuth (console.cloud.google.com -> Credentials)
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Express API base URL (used by server components and the /backend rewrite)
API_URL=http://localhost:5000

# imgbb API key for image uploads (api.imgbb.com)
NEXT_PUBLIC_IMGBB_KEY=
